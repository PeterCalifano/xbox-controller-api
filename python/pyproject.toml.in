[build-system]
requires = ["setuptools>=61", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "@PROJECT_NAME@"
version = "@PYTHON_PACKAGE_VERSION@"
description = "Python bindings for @PROJECT_NAME@ (Xbox controller input)."
requires-python = ">=3.12"
license = {text = "MIT"}
authors = [
  {name = "Pietro Califano", email = "petercalifano.gs@gmail.com"}
]

[tool.setuptools]
packages = ["@PROJECT_NAME@"]
include-package-data = true

[tool.setuptools.package-data]
"@PROJECT_NAME@" = ["*.so", "*.so.*", "*.pyd", "*.dll", "*.dylib", "*.pyi", "**/*.pyi"]
